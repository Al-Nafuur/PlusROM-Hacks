AFTER_VICTORY_SONG = #%00000100
WON_PLAY_VICTORY_SONG = #%00001000
START_GAME = #%01000000
START_JINGLE = #%10000000
;1 - 00000000 in game
;2 - 00000001 title screen
;3 - 00000010 you lost before title screen
;4 - 00000100 you won after the jingle
;5 - 00001000 you won and play jingle
;6 - 01000000 play jingle before to shoot
;7 - 10000000 signal for "start jingle"
    
	SEG.U VARS
	ORG $80
;;;;;;;;;;;;;;; RAM ;;;;;;;;;;;;;;;;
TankInRam ds 8
ColorTankInRam ds 8
ColorGRP1 ds 8
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
GameOver ds 1
;1 - 00000000 in game
;2 - 00000001 title screen
;3 - 00000010 you lost before title screen
;4 - 00000100 you won after the jingle
;5 - 00001000 you won and play jingle
;6 - 01000000 play jingle before to shoot
;7 - 10000000 signal for "start jingle"
