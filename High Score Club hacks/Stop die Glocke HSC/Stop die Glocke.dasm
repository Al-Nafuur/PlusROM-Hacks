TablePointerSpritesLow
    .byte <TankOne, <TankTwo, <TankThree
TablePointerSpritesHi
    .byte >TankOne, >TankTwo, >TankThree
TableSpeedFrame0
	.byte $02, $01, $01, $01, $01, $01, $01, $01, $01, $01, $01, $01
TableSpeedFrame1
	.byte $02, $02, $02, $02, $02, $02, $02, $02, $01, $01, $01, $01
;select by KindOfGRP1
;02 = double speed = ambulance
;01/02* = 1.5 speed = GrassHump, tank, wall, truck
;01 = 1 speed = truck whit explosive
;* one frame 1px and one frame 2px
TableKindOfGRP1Low
	.byte <Ambulance, <GrassHump, <TankOne, <Wall, <HalfWall, <Block, <Boulder, <Truck, <Truck, <Explosion0, <Explosion1, <Explosion2
TableKindOfGRP1Hi
	.byte >Ambulance, >GrassHump, >TankOne, >Wall, >HalfWall, >Block, >Boulder, >Truck, >Truck, >Explosion0, >Explosion1, >Explosion2
TableSpriteColorLow
	.byte <ColorAmbulance, <ColorGrassHump, <ColorTank, <ColorWall, <ColorWall, <ColorBlock, <ColorBoulder, <ColorTruck, <ColorTruck, <ColorExplosion, <ColorExplosion, <ColorExplosion
TableSpriteColorHi
	.byte >ColorAmbulance, >ColorGrassHump, >ColorTank, >ColorWall, >ColorWall, >ColorBlock, >ColorBoulder, >ColorTruck, >ColorTruck, >ColorExplosion, >ColorExplosion, >ColorExplosion
TablePointerNumbersLow
	.byte <Number0, <Number1, <Number2, <Number3, <Number4, <Number5, <Number6, <Number7, <Number8, <Number9
TablePointerNumbersHi
	.byte >Number0, >Number1, >Number2, >Number3, >Number4, >Number5, >Number6, >Number7, >Number8, >Number9
TablePointerTreeLow
	.byte <TreeZero, <TreeOne, <TreeTwo, <Treethree
TablePointerTreeHi
	.byte >TreeZero, >TreeOne, >TreeTwo, >Treethree
TableCoordCopies
;check this coordinate for to know when active a copy
	;      0,  140, 124, 124, 116, 108, 108, 108
	.byte $00, $8C, $7C, $7C, $63, $63, $63, $63
TableNUSIZRegister
	.byte $00, $01, $02, $03, $04, $06, $06, $06
TableTreeNewCoordinate
;when the tree arrives on the left, set new coordinate
;	          $9C/156,  16,  32,  16,  64,  32,  32,  32
	.byte #END_SCREEN, $13, $23, $13, $43, $23, $23, $23
	;.byte #END_SCREEN-1, $10, $20, $10, $40, $20, $20, $20
TableTreeArrivesAtZero
;when the tree arrive on the left, set new value copy
	.byte $00, $00, $00, $01, $00, $02, $02, $02
;when the tree arrives at 0, the table gives the next value
;id TableCoordCopies
;0 *			->null
;1 * *			->0
;2 *   *		->0
;3 * * *		->1
;4 *       *	->0
;5 *   *   *	->2 not real but used in every table
;6 *   *   *	->2
;7 *   *   *	->2 not real but used in every table

TableSfxLow
    .byte <SfxAmbulanceDown, <SfxGrassHump, <SfxTank, <SfxWall, <SfxHalfWall
    .byte <SfxBlock, <SfxBoulder, <SfxTruck, <SfxExplosionTruck
    .byte <SfxM0, <SfxCXP0P1, <SfxCXM0M1, <SfxCXP0M1, <SfxCXBLP0
	.byte <IntroSongCh0, <IntroSongCh1
	.byte <VictorySongCH0, <VictorySongCH1
TableSfxHi
	.byte >SfxAmbulanceDown, >SfxGrassHump, >SfxTank, >SfxWall, >SfxHalfWall
    .byte >SfxBlock, >SfxBoulder, >SfxTruck, >SfxExplosionTruck
    .byte >SfxM0, >SfxCXP0P1, >SfxCXM0M1, >SfxCXP0M1, >SfxCXBLP0
	.byte >IntroSongCh0, >IntroSongCh1
	.byte >VictorySongCH0, >VictorySongCH1
Start CLEAN_START

initializingMainVariables
	;when turns on...
	;draw logo	
	;lda #0;TimeForChangeScreen
	;sta TimerTitleScreen ;at the first start, it has the value for the logo screen
	;set Volumes to 0 for no sound when reset is pressed
	lda #0
	sta AUDV0
	sta AUDV1
	;scrolling counter
    ;lda #0
    ;sta CounterScrollingPf
	;Ball x 4 - Playfield mirror
    lda #$25
    sta CTRLPF
	lda #$30
	sta PF0

	lda #TITLE_SCREEN
    sta GameOver

	lda #0;NUM_TANKS_BEGIN_GAME
	sta DamageTank

	lda #END_OF_LINE_MISSILE
	sta CoordXGRP1
	sta CoordXMissile1

	lda #95;100
	sta CoordXTreeGRP0
	lda #52
	sta CoordXTreeGRP1

    lda #72
    sta XBush1
    lda #40
    sta XBush0

	lda #6
	sta TreesNUSIZ0
	lda #4
	sta TreesNUSIZ1

NextFrame
	VERTICAL_SYNC

verifyReset
	lsr SWCHB ;test Game Reset switch
	bcs setTimer ;reset?
	jmp Start

setTimer
    lda #44 ;37 lines x 76 cycles per lines = 2812 cycles / 64 = 43
    sta TIM64T

abosoluteTimer
	;TimerForAll takes 4 seconds in 60hz to arrives at 0
	inc TimerForAll ;must always run
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
startJingle
;change case 6 to 0
	lda GameOver
	and #START_GAME ;case 6
	beq endStartJingle
	lda TimerForAll
	bne endStartJingle
	;lda #IN_GAME ;#0
	sta GameOver
endStartJingle
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
manageCounters
	lda GameOver
	bne exitManageCounters ;if GameOver then exit
    inc SixtyFramesOneSecond
    lda SixtyFramesOneSecond
    cmp #60 ;60 fps = 1 second
    bne exitManageCounters
    lda #0
    sta SixtyFramesOneSecond

    inc Seconds
    lda Seconds
    cmp #60 ;60 fps = 1 second
    bne exitManageCounters
    lda #0
    sta Seconds
    sed
    lda Minutes
    sec ;When the carry is set, SBC performs the calculation A = A - Minutes
    sbc #1
    sta Minutes
    cld
    bne exitManageCounters
  IF PLUSROM == 1
	jsr SendPlusROMVictory
	nop
  ELSE
  	lda #WON_PLAY_VICTORY_SONG ;#%00001000
	sta GameOver
  ENDIF
exitManageCounters
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;bomber comes on the screen when timer is 0;;;;;;;
timerBomberOnScreen
	lda TimerBomberGRP0
	beq otherTimer ;already on Screen
	dec TimerBomberGRP0
otherTimer
	lda TimerBomberGRP1
	beq exitTimerBomber ;already on Screen
	dec TimerBomberGRP1
exitTimerBomber
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;every n cycles the bomber follow MyTank
followMyTank
	lda TimerForAll
	and #%00111111 ;mask every cycles check position MyTank
	bne exitFollowMyTank
	lda CoordXMyTank
	sta PntToReach1 ;tail
	clc
	adc #8
	sta PntToReach0 ;cockpit
exitFollowMyTank
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
stopBomberWhenBombimg
	lda PointerBombsInRow
	cmp #POINTER_BOMBING-10 ;move bomber only after 10 line on the stack-bombs
	bpl fallingBombs;setTarget
exitStopBomberWhenBombimg
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;manage timers and two parts of bomber
	ldx #1
manageTimersPartsOfBomber
	lda TimerForAll ;slower bomber
	and #%00000001
	beq exitSetTarget;setTarget
	lda TimerBomberGRP0,x
	bne otherPart ;wait timer
bomberPosition
	lda CoordXBomberGRP0,x ;verify
	cmp PntToReach0,x
	beq otherPart ;if 0 then exit
	bmi bomberGoForward ;if positive then bomber goes back
	dec CoordXBomberGRP0,x ;bomber goes backward
	jmp otherPart
bomberGoForward
	inc CoordXBomberGRP0,x
otherPart
	dex
	bpl manageTimersPartsOfBomber ;bomberPosition
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
setTarget
    lda GameOver
    bne exitFallingBombs ;if game over no bombs

	lda PointerBombsInRow
	bne exitSetTarget ;if already bombing then jump
	lda CoordXBomberGRP0
    sta CoordXBombs ;position falling bombs
    lda #POINTER_BOMBING ;set pointer first bomb
	sta PointerBombsInRow
exitSetTarget
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
fallingBombs
    lda PointerBombsInRow
    beq exitFallingBombs ;if zero exit
    dec PointerBombsInRow ;then decrease pointer
exitFallingBombs
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
moveTrees
;speed 1
	dec CoordXTreeGRP0
	dec CoordXTreeGRP1
;manage values tree
;when CoordX = 0 then set CoordX = 156
	ldx #0
	jsr ManageTrees
	ldx #1
	jsr ManageTrees
endMoveTrees
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
checkJoy
    JOYSTICK_MACRO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;if missile0 not run lock the missile to the tank
    lda BooleanM0Runs
    beq resetMissile0 ;if not runs set every fame on tank
updateMyMissile
	lda #%10000000
	bit CXPPMM ;check collision GRP0 GRP1 
	beq checkCollM0P1
	lda KindOfGRP1
	bne checkCollM0P1 ;if not ambulance check collision with missile
	jmp positionigMyMissile ;if ambulante collides with tank, missile can run
checkCollM0P1
    lda #%10000000
	bit CXM0P ;check collision M0 GRP1
	bne resetMissile0
positionigMyMissile
    inc CoordXMissile0
	inc CoordXMissile0
	lda Missile0Range ;check if missile is arrived
	cmp CoordXMissile0
	bpl endUpdateMyMissile ;when arrived reset misile1
resetMissile0
    lda #FALSE
	sta BooleanM0Runs ;missile not runs
    clc
	lda CoordXMyTank
	adc #OFFSET_MISSILE_0 ;offset for corret position M0
	sta CoordXMissile0 ;set M0 position on tank
endUpdateMyMissile
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;update positions enemies
updateEnemy
	lda CoordXGRP1
	cmp #START_SCREEN ;or# 140 truck stops; if not arrived at the end
	bne readTable ;skip update new grp1
manageEntryTimer
	;lda KindOfGRP1
	;and #%10000000 ;no new grp1 if missile still alive
	;bne exitUpdateEnemy
	;timer start when boolean is false
	dec TimerWhenGRP1Appears ;no missile so decrease the timer
	bne exitUpdateEnemy ;no zero then no new entry
	;;;;;;;;;;;;;;;;;;;;;;
	jsr nextSprite ;load new entry when timer is zero
	;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;initialize position
;here it manages 2 speed - 1px, 1.5px, 2px
moveIt
	lda #END_SCREEN ;new coordinate to P1/M1
	sta CoordXGRP1 ;save grp1 coordinate
	lda #END_OF_LINE_MISSILE
	sta CoordXMissile1 ;save missile coordinate
readTable
	ldy KindOfGRP1
	lda TimerForAll
	and #%00000001 ;read alternate tables for different speed
	beq TableZero
TableOne
	ldx TableSpeedFrame1,y ;select the speed by kind of sprite
	jmp afterTable
TableZero
	ldx TableSpeedFrame0,y ;select the speed by kind of sprite
afterTable
	dec	CoordXGRP1 ;here the speed of movement
	jsr doubleCopy
	jsr noDoubleCopy
	lda CoordXGRP1
	cmp #START_SCREEN
	beq exitUpdateEnemy ;check every step
	dex ;loop for speed
	bne afterTable
exitUpdateEnemy
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;update positions missile grp1
updateEnemyMissile
	;lda KindOfGRP1
	;cmp #2 ;enemy tank in the table
	;and #%10000000 ;bit7=1 missile - 0 no missile
	;bne exitUpdateMissile1 ;if not alive esc
	lda TimerMissileTank
	and #%10000000
	beq exitUpdateMissile1

timerMissile
	lda TimerMissileTank ;check timer M1,x
	and #%01111111
	beq moveMissile ;if zero then must run
	dec TimerMissileTank ;decrease timer

 	;before it moves I set right position of M1
	lda CoordXGRP1
	sta CoordXMissile1 ;grp1 and M1 stay togheter
	inc CoordXMissile1
	jmp exitUpdateMissile1

moveMissile
    dec CoordXMissile1 ;bullet speed
	lda CoordXMissile1 ;check if M1 arrived
	cmp #END_OF_LINE_MISSILE
	beq endMissile
    dec CoordXMissile1
	lda CoordXMissile1 ;check if M1 arrived
	cmp #END_OF_LINE_MISSILE
	beq endMissile
;speed 2.5;;;;;;;;;;;;;;
	lda TimerForAll
	and #%00000001
	beq exitUpdateMissile1
	dec CoordXMissile1
	lda CoordXMissile1 ;check if M1 arrived
	cmp #END_OF_LINE_MISSILE
	beq endMissile
;;;;;;;;;;;;;;;;;;;;;;;
	jmp exitUpdateMissile1
endMissile
	;lda KindOfGRP1
	;and #%01111111 ;turn off M1
	;sta KindOfGRP1
	lda #END_OF_LINE_MISSILE
	sta CoordXMissile1
	lda #0
	sta TimerMissileTank
exitUpdateMissile1
;end update positions enemy missiles
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;now verify collisions between P0 and P1
verifyCollisionPP
	lda #%10000000
	bit CXPPMM ;check collision P0P1
	beq exitCollisionPP ;if 0 no collision
	lda KindOfGRP1
	beq exitCollisionM0P1 ;if ambulance exit without check CXM0P1
;check if explosion is at the last frame before to decrease the damage
    lda BooleanExplosion
	beq noExplosion
	lda KindOfGRP1
	cmp #ID_LAST_EXPLOSION ;last frame explosion
	bne jumpOut
	lda DamageTank
    beq exitCollisionPP ;avoid to go under zero
	dec DamageTank
jumpOut
	jmp exitCollisionM0P1
;;;;;;;;;;;;
noExplosion
;maybe double GrassHump
	lda GrassHumpNUSIZ1
	and #%00000001
	beq noDoubleGrassHump0
	jsr manageDouble
	jmp checkDamagePP
;;;;;;;;;;;;
noDoubleGrassHump0
	lda #START_SCREEN
	sta CoordXGRP1
checkDamagePP
    lda DamageTank
    beq exitCollisionPP ;avoid to go under zero
	dec DamageTank

	lda #ID_SOUND_P0P1
	sta IdSfx
	;manage possible enemy missile
	;jsr stopPossibleMissile
exitCollisionPP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;now verify collisions between M0 and P1
verifyCollisionM0P1
	lda #%10000000
	bit CXM0P ;check collision M0P1
	beq exitCollisionM0P1 ;if 0 no collision
	;there is collision then set sfx
    lda KindOfGRP1
    sta IdSfx
;;;;;;;;;;;;
maybeTruck
	lda KindOfGRP1
	cmp #ID_TRUCK
	bne maybeWall ;no truck or explosion is on
	sta BooleanExplosion
	jmp exitCollisionM0P1
noTruck
;;;;;;;;;;;;
maybeWall
	lda KindOfGRP1
	cmp #ID_WALL
	bne noWall
	lda #ID_HALF_WALL
	sta KindOfGRP1
	jmp exitCollisionM0P1
noWall
;;;;;;;;;;;;
maybeDoubleGrassHump
	lda GrassHumpNUSIZ1
	and #%00000001
	beq noDoubleGrassHump
	jsr manageDouble
	jmp exitCollisionM0P1
noDoubleGrassHump
;;;;;;;;;;;;
	lda #START_SCREEN
	sta CoordXGRP1 ;hit then new coordinate
	lda KindOfGRP1
	bne exitCollisionM0P1 ;if not hit ambulance
    lda DamageTank
    beq exitCollisionM0P1 ;avoid to go under zero
	dec DamageTank ;ambulance down
exitCollisionM0P1
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;now verify collisions between M0 and M1
verifyCollisionM0M1
	lda #%01000000
	bit CXPPMM ;check collision M0P1
	beq exitCollisionM0M1 ;if 0 no collision
	lda #0 ;#FALSE
	sta TimerMissileTank ;delete bit of trigger missile and timer
	sta BooleanM0Runs ;missile not runs
	lda #END_OF_LINE_MISSILE
	sta CoordXMissile1
	lda CoordXMyTank
	adc #OFFSET_MISSILE_0 ;offset for corret position M0
	sta CoordXMissile0 ;set M0 position on tank
	lda #ID_SOUND_M0M1
	sta IdSfx
exitCollisionM0M1
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;now verify collisions between M1 and P0
verifyCollisionM1P0
	lda #%10000000
	bit CXM1P ;check collision M0P1
	beq exitCollisionM1P0 ;if 0 no collision
	lda #0 ;#FALSE
	sta TimerMissileTank ;delete bit of trigger missile and timer
	lda #END_OF_LINE_MISSILE
	sta CoordXMissile1
    lda DamageTank
    beq exitCollisionM1P0 ;avoid to go under zero
	dec DamageTank
	lda #ID_SOUND_P0M1
	sta IdSfx
exitCollisionM1P0
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;verify collision between BALL (bomber missiles) and P0
veryfyCollisionBLP0
	lda #%01000000
	bit CXP0FB
	beq exitCollisionBLP0 ;if 0 no collision
    lda DamageTank
    beq exitCollisionBLP0 ;avoid to go under zero
	dec DamageTank
	lda #FALSE ;zero
	;sta BooleanBombingRuns
	sta PointerBombsInRow
	lda #ID_SOUND_CXBLP0
	sta IdSfx
exitCollisionBLP0
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
checkGameOver
	lda GameOver
	bne continueGame
	lda DamageTank
	bne continueGame
	lda #BEFORE_TITLE_SCREEN ;#%00000010
	sta GameOver
	lda #FALSE ;hide MyTank
  IF PLUSROM == 1
	jsr SendPlusROMDefeat
	nop
  ELSE
	sta MaskShowHideMyTank ;show or hide my Tank
	sta PointerBombsInRow ;set to zero
  ENDIF

continueGame

manageGameOver
	lda GameOver
	and #BEFORE_TITLE_SCREEN ;#%00000010
	beq exitManageGameOver
	inc TimerTitleScreen ;first time from 0 to 1
	;for to have 0 must go behind 255
	bne exitManageGameOver ;if not 0 jump
	lda #TITLE_SCREEN ;#%00000001
	sta GameOver
exitManageGameOver
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
manageExplosion
	lda BooleanExplosion
	beq exitManageExplosion
	inc KindOfGRP1
	ldx KindOfGRP1
	cpx #ID_EXPLOSION
	bne checkFinalExpl
setCoordExpl
	clc
	lda CoordXGRP1
	sbc #16
	sta CoordXGRP1 ;new coordinate of explosion
	jmp exitManageExplosion
checkFinalExpl
	;ldx KindOfGRP1 ;already in x
	cpx #ID_LAST_EXPLOSION+1 ;9
	bne exitManageExplosion
	lda #START_SCREEN
	sta CoordXGRP1
	lda #0
	sta BooleanExplosion
	lda #ID_TRUCK
	sta KindOfGRP1
exitManageExplosion
