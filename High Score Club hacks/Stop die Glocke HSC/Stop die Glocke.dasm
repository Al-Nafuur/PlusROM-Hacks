	lda GrassHumpNUSIZ1
	and #%00000001
	beq storeMissile1
	ldy #0
storeMissile1
    sty Missile1
;;;;;;;;;;;;;;;;;;;;
	lda #1
	sta VDELP1
;;;;;;;;;;;;;;;;;;;;
	sta WSYNC
	sta HMOVE
;bombing;;;;;;;;;;;;
	lda bombsInRow,x
	sta ENABL
	inx
;;;;;;;;;;;;;;;;;;;;
setSizeExplosion
	lda KindOfGRP1
	cmp #ID_TRUCK+1 ;first frame explosion
	bmi another
	lda #%00100111
	sta NUSIZ1
	jmp postAnother
another
	lda GrassHumpNUSIZ1
	sta NUSIZ1
postAnother
    lda BooleanM0Runs;when false is zero
	and #%00001000 ;when true #8 is necessary
	;for a correct manage of P0P1 collision with no missile ON
    and MaskShowHideMyTank ;used for disable missiles :)
    sta Missile0

    ldy #7
action
	lsr Missile0
	lsr Missile1
	lda (PointerMultiUseTwoLow),y
	sta GRP1
	lda bombsInRow,x
	;and MaskShowHideMyTank ;used for disable missiles :)
	sta ENABL
	lda TankInRam,y
	sta WSYNC
    ;sta HMOVE
	sta GRP0
	lda ColorGRP1,y
	sta COLUP1
	lda Missile1
	sta ENAM1
	lda ColorTankInRam,y
	sta COLUP0
	lda Missile0
	sta ENAM0
;bombing;;;;;;;;;;;;
	;lda bombsInRow,x
	;sta ENABL
	inx
;;;;;;;;;;;;;;;;;;;;
	dey
	bpl action
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;everything is drawen
lastLand
    lda #0
	sta GRP1
    sta WSYNC
	sta GRP0
	sta PF1
	sta PF2
    lda #DARK_GREEN	;draw space
    sta COLUBK
	lda #0
    sta ENABL
	sta ENAM0
    sta ENAM1
	sta REFP1
	sta REFP0
	sta VDELP1
    ;sta VDELBL
	ldx #19;24/33
DrawGreen
	sta WSYNC	;wait for next scanline
    dex
	bne DrawGreen
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    ldx #0
    jsr moveBush
    lda XBush0
    ldy #0
	jsr roundPosition

    ldx #1 ;no ball enabled
    jsr moveBush
    lda XBush1
    ldy #1
	jsr roundPosition

	ldx #GREEN_LEAF_GRP0
    lda GameOver ;show or hide by color the bush
	sta WSYNC
    sta HMOVE
	beq storeColorBush ;zero means it is in game
	and #MASK_SCROLLING_BUSH ;check by mask
	bne storeColorBush
	ldx #DARK_GREEN
storeColorBush
    stx COLUP0
    stx COLUP1

    ldy #3
drawBush
    lda LeftDownCloud,y
    sta WSYNC
    sta GRP0
    lda RightDownCloud,y
    sta GRP1
	dey
    bne drawBush
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 
; Reenable VBLANK for bottom (and top of next frame)
LVOver
	sta WSYNC
	lda #2
	sta VBLANK

	lda #0
    sta GRP0
    sta GRP1
	sta COLUBK

	lda #36 ;29 lines x 76 cycles per line = 2204 cycles / 64 = 34
	sta TIM64T

soundEffect
	PLAY_SOUND_MACRO
	;jsr manageDifficult

LoopaOverscan
	lda INTIM
	bne LoopaOverscan

	jmp NextFrame

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;               FINAL SCENE CODE                ;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
finalScene
	sta WSYNC
	lda #71
	ldy #0
	sty PF1
	sty PF2
	jsr roundPosition
	lda #79
	ldy #1
	jsr roundPosition

	sta WSYNC
	sta HMOVE

	ldy #24
drawBeforeStructure
	sta WSYNC
	dey
	bne drawBeforeStructure

	ldy #7
drawStructure
	sta WSYNC
	ldx #0
	lda structure,x
	sta PF1
	inx
	lda structure,x
	sta PF2
	dey
	bne drawStructure
;draw columns
	sta WSYNC
	ldx #2
	lda structure,x
	sta PF1
	inx
	lda structure,x
	sta PF2

	ldy #5
spaceStructure
	sta WSYNC
	dey
	bpl spaceStructure

	lda #BROWN_LAND
	sta COLUBK
	sta WSYNC
	sta WSYNC
	sta WSYNC
	sta WSYNC

	ldy #38
drawGlocke
	sta WSYNC
	lda #1 ;double copy
	sta NUSIZ0
	ldx #8
	lda glocke_0,y
	sta GRP0
	lda glocke_1,y
	sta GRP1
	lda #WHITE
	sta COLUP0
	sta COLUP1
	SLEEP #17
	stx REFP0
	lda #0 ;reflect
	sta REFP0
	dey
	bpl drawGlocke
	sty REFP0
	jmp lastLand ;use the code in game for the ground
