	ldy FrameCounter
definePointerMyTank
	lda TimerForAll
	and #%00000011 ;change myTank frame every 4 frames
	bne setFrameGRP0
	iny
	cpy #3
	bne noSetY
	ldy #0
noSetY
	sty FrameCounter
setFrameGRP0
    lda TablePointerSpritesLow,y
    sta PointerMultiUseOneLow
    lda TablePointerSpritesHi,y
    sta PointerMultiUseOneHi
setColorGRP1
	ldy KindOfGRP1
	lda TableSpriteColorLow,y
	sta PointerMultiUseTwoLow
	lda TableSpriteColorHi,y
	sta PointerMultiUseTwoHi

    ldy #7
copyTankInRam
;data grp0
	lda (PointerMultiUseOneLow),y
	and MaskShowHideMyTank ;used for the game over
	sta TankInRam,y
;copy color tank in ram
    lda ColorTank,y ;its color
    ;if there is damage set red color and update TempDamage
    ldx DamageTank
    cpx TempDamage
    beq storeColorTankInRam ;no damage
    lda #WHITE ;with damage tank becomes white
storeColorTankInRam
    sta ColorTankInRam,y
;copy color grp1 in Ram
	lda (PointerMultiUseTwoLow),y
	sta ColorGRP1,y
	dey
	bpl copyTankInRam

    stx TempDamage ;damage or not, update value

