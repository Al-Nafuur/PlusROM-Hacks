  IF PLUSROM
    echo "------", [*], [* - $F000]d, "SendPlusROM"
SendPlusROMVictory
  	lda #WON_PLAY_VICTORY_SONG ;#%00001000
	sta GameOver
	jmp SendPlusROMScore

SendPlusROMDefeat
	sta MaskShowHideMyTank ;show or hide my Tank
	sta PointerBombsInRow ;set to zero
SendPlusROMScore
    lda Minutes
    sta WriteToBuffer           ; "score" hi
    lda Seconds                 ;3
    sta WriteToBuffer           ; "score" lo
    lda DamageTank
    sta WriteToBuffer           ; DamageTank
    lda #HIGHSCORE_ID           ; game id in Highscore DB
    sta WriteSendBuffer
    rts

    echo "------", [*], [* - $F000]d, "PlusROM_API"
PlusROM_API
       .byte "a", 0, "h.firmaplus.de"
       .byte 0
	org $fffa
    .word (PlusROM_API - $E000)

  ENDIF

	org $fffc
	.word Start

	.word Start