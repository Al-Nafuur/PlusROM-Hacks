;SUBROUTINE
moveBush
    lda #%00100111 ;quad size
    sta NUSIZ0,x
    lda XBush0,x
    bne contBush
    lda #160
    sta XBush0,x
contBush
    dec XBush0,x
    dec XBush0,x
    dec XBush0,x
    dec XBush0,x
    rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE called by PLAY_SOUND_MACRO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
SoundEffectCH0
	ldy CursorSound0
	;last 3 datas must be zero, so all the sounds stop
	lda (SoundDataLow0),y
	sta AUDC0
	iny
	lda (SoundDataLow0),y
	sta AUDF0
	iny
	lda (SoundDataLow0),y
	sta TempoCH0
	beq .endSoundCH0
	iny
	sty CursorSound0
.endSoundCH0
	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE called by PLAY_SOUND_MACRO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
SoundEffectCH1
	ldy CursorSound1
	;last 3 datas must be zero, so all the sounds stop
	lda (SoundDataLow1),y
	sta AUDC1
	iny
	lda (SoundDataLow1),y
	sta AUDF1
	iny
	lda (SoundDataLow1),y
	sta TempoCH1
	beq .endSoundCH1
	iny
	sty CursorSound1
.endSoundCH1
	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
nextSprite
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	lda #%00100000 ;set size missile
	sta GrassHumpNUSIZ1 ;and zero copies

	ldy Cursor
	inc Cursor
	lda Loopa,y ;seed ... must start somewhere ;)
 ;get random value
    bcc notEor    
	eor $80,y
notEor
	and #%00000111 ;mask for the object
	cmp #ID_HALF_WALL
	bne storeKind
	lda #ID_TRUCK
storeKind
	sta KindOfGRP1

;maybe more copies of the GrassHump
	;lda KindOfGRP1 ;already in AC
	cmp #ID_GRASS_HUMP
	bne randomTimer ;if not GrassHump not set possible copies
	lda nextSprite,y ;must start somewhere ;)
	and #%00000001 ;maybe 1 copy
	ora #%00100000 ;size missile
	sta TmpGrassHumpNUSIZ1

randomTimer
	;random generator used for missile timer
	lda nextSprite,y ;seed ... must start somewhere ;)
 ;get random value
    asl
    bcc noEor
    eor #$1d
noEor
	and #%00111000 ;set difficult!!!!!!!!!!!
	ora #%00000111 ;never zero - if zero means 4 seconds of waiting
	sta TimerWhenGRP1Appears
	and #%00000111 ;manage the difficult, but not important
	ora #%00000001 ;never zero
	sta TimerMissileTank
setTriggerTimerTank
	lda KindOfGRP1
	cmp #IS_TANK
	bne return
	lda TimerMissileTank
	ora #%10000000
	sta TimerMissileTank ;set it is a tank and has timer
return	
	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
drawLogo
	lda #0
	sta GRP0
	sta GRP1
	ldy #2
deltaFrameUp
	sta WSYNC
	dey
	bne deltaFrameUp

	lda #3
	sta NUSIZ0
	sta NUSIZ1	; both players have 3 copies
	;lda #1
	sta VDELP0
	sta VDELP1
	lda #59
	ldy #0
	jsr roundPosition ;position GRP0

	lda #67
	ldy #1
	jsr roundPosition ;position GRP1

	sta WSYNC
	sta HMOVE

	lda #20 ;logo dimension
	sta TempX

	lda ColorLogo ;#COLOR_LOGO_ON/#COLOR_LOGO_OFF
	sta COLUP0
	sta COLUP1

.drawLoopLogo
	ldy TempX ;counts backwards
	lda logo_5,y ;6th
	sta TempY

	sta WSYNC
	SLEEP #8
	lda logo_0,y ;1st
	sta GRP0
	lda logo_1,y ;2nd
	sta GRP1
	lda logo_2,y ;3rd
	sta GRP0
	lda logo_4,y ;5th
	tax
	lda logo_3,y ;4th
	ldy TempY
	sta GRP1 ;4th
	stx GRP0 ;5th
	sty GRP1 ;6th
	sta GRP0
	dec TempX ;go to next line

	bpl .drawLoopLogo ;repeat until < 0

	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; SUBROUTINE
;manage values tree
;when CoordX = 0 then set CoordX = 156
ManageTrees	
	lda CoordXTreeGRP0,x
	cmp #END_OF_LINE_MISSILE-1
	bne setNewNUSIZ ;if tree not arrived on the left on the screen
	;if arrived it can be the last or must set new copy or copies
	ldy TreesNUSIZ0,x ;current situation of the copies
	lda TableTreeArrivesAtZero,y ;set new N copy
	sta TreesNUSIZ0,x
    lda TableTreeNewCoordinate,y ;either new coordinate at the right of the screen
	sta CoordXTreeGRP0,x ;or the coordinate for the first grp after one is gone
    cmp #END_SCREEN ;if new coord is the right side of the screen
    bne exitFromManageTrees ;if not then jump
    ;choose new kind of tree
    ldy IdTreeCounter
	lda checkJoy,y ;must start somewhere :)
	lsr
	and #%00000011 ;mask for possible tree
	sta NextTreeGRP0,x ;set new tree
    inc IdTreeCounter
	;choose how many future copies
	lda TankOne,y ;must start somewhere :)
	and #%00000111 ;mask
	tay
	lda TableNUSIZRegister,y ;real value of possible copies
	sta FromValueNUSIZ0,x
	tay
	lda TableTreeArrivesAtZero,y ;possible intermediate values ie: from 2 to 3 copies
	sta ToValueNUSIZ0,x
	rts ;jmp exitFromManageTrees
setNewNUSIZ
	ldy ToValueNUSIZ0,x
	lda TableCoordCopies,y
	cmp CoordXTreeGRP0,x
	bne exitFromManageTrees
	sty TreesNUSIZ0,x
	lda FromValueNUSIZ0,x
	sta ToValueNUSIZ0,x
exitFromManageTrees
	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE 
;init variables every start game
initVariables
	lda #VOLUME
	sta AUDV0
	sta AUDV1

	lda TimerForAll
	sta Cursor ;save value for next game

	lda #START_JINGLE ;case 7
	sta GameOver

    lda #FALSE ;#0
    sta SixtyFramesOneSecond
    sta TimerForAll ;reset timer
	sta PointerBombsInRow	
	sta TimerWhenGRP1Appears
	sta BooleanExplosion
	sta TimerMissileTank
	sta MyFire
	sta GrassHumpNUSIZ1
	sta TempoCH0
	sta TempoCH1
	sta CursorSound0
	sta CursorSound1
    sta Seconds ;for timer

	lda #TRUE ;show MyTank
	sta MaskShowHideMyTank ;show my Tank after game over
    ;lda #$ff
    sta IdSfx ;necessary for play sound in one channel once

;init value damage
	lda #NUM_TANKS_BEGIN_GAME
	sta DamageTank
    sta TempDamage

;MyTank position in X
	lda #LEFT_LIMIT_MY_TANK
	sta CoordXMyTank
	sta CoordXMissile0
;position GRP1 and Missile1
	lda #END_OF_LINE_MISSILE
	sta CoordXGRP1
	sta CoordXMissile1
;bomber parameters
	lda #START_SCREEN
	sta CoordXBomberGRP0
	sta CoordXBomberGRP1
    lda #238 ;238
    sta TimerBomberGRP0
    lda #254 ;254
    sta TimerBomberGRP1
	
	lda #%00100000 ;size missile
	sta GrassHumpNUSIZ1
	sta TmpGrassHumpNUSIZ1

    lda #%00010000 ;set 10 seconds used in decimal mode
    sta Minutes

	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
roundPosition
    sec
	sta WSYNC
	stx ENABL;bit 0
.DivideLoop
	sbc #15
	bcs .DivideLoop
	eor #7
	asl
	asl
	asl
	asl
	sta RESP0,y ;fix course position
    sta WSYNC
	sta HMP0,y
	rts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
bombingIt
	sta WSYNC
	lda bombsInRow,x
	sta ENABL
	inx
	rts
;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
bombingItVersOne
	lda bombsInRow,x
	inx ;bombing
	stx TempX
	tax
	rts
;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
doubleCopy
	lda KindOfGRP1
	cmp #ID_GRASS_HUMP
	bne exitDoubleCopy
	lda CoordXGRP1
	cmp #147 ;coordinate when active the copy
	bne exitDoubleCopy
	lda TmpGrassHumpNUSIZ1
	sta GrassHumpNUSIZ1
	;lda #%00100000
	;sta TmpGrassHumpNUSIZ1
exitDoubleCopy
	rts
;;;;;;;;;;;;;;;;;;;;
;SUBROUTINE
noDoubleCopy
	lda KindOfGRP1
	cmp #ID_GRASS_HUMP
	bne exitNoDoubleCopy
	lda GrassHumpNUSIZ1
	and #%00000001
	beq exitNoDoubleCopy
	lda CoordXGRP1
	cmp #END_OF_LINE_MISSILE ;coordinate when stop the copy
	bne exitNoDoubleCopy
manageDouble
	lda #%00100000 ;set no copy and size missile
	sta GrassHumpNUSIZ1
	lda CoordXGRP1
	clc
	adc #16
	sta CoordXGRP1
exitNoDoubleCopy
	rts
